# Caddy reverse proxy + automatic TLS (Let's Encrypt), per
# kindergarten-docs/docs/01-stage1-plan.md §8's production stack.
#
# Two public hostnames, one server, one Caddy:
#
#   {$UI_DOMAIN}   e.g. alishaxkids.uz      -> web:3000  (TanStack Start SSR, separate repo)
#   {$API_DOMAIN}  e.g. api.alishaxkids.uz  -> api:3000  (this repo)
#
# Both are substituted from the environment Caddy is started with
# (docker-compose.prod.yml's `caddy` service reads them from
# .env.production) — nothing to hand-edit here per deploy. Caddy obtains
# and renews a separate certificate for each hostname automatically.
#
# BOTH names must already resolve (A/AAAA record) to this server's public
# IP before Caddy starts, or the ACME HTTP-01 challenge fails for whichever
# one doesn't and that host falls back to plain HTTP. Check
# `docker compose logs caddy` if TLS doesn't come up.

{
	email {$ACME_EMAIL}
}

# --- client UI --------------------------------------------------------
# The web container serves SSR pages and assets, including deep links.
# The API route also supports frontend clients configured for same-origin calls.
{$UI_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}

# --- backend API ------------------------------------------------------
{$API_DOMAIN} {
	encode gzip

	reverse_proxy api:3000

	log {
		output stdout
		format json
	}
}

# --- optional: www -> apex redirect -----------------------------------
# Uncomment ONLY after adding a `www` A record. Without one, Caddy retries
# (and logs) a certificate order for a name that doesn't resolve.
#
# www.{$UI_DOMAIN} {
# 	redir https://{$UI_DOMAIN}{uri} permanent
# }
