# Production env template for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   bash scripts/generate-prod-secrets.sh .env.production   # fills every REPLACE_ME
#
# Then hand-fill DOMAIN, ACME_EMAIL, SEED_OWNER_EMAIL, and anything under
# --- telegram / --- observability you're actually turning on.
#
# This file is consumed TWO ways by docker-compose.prod.yml:
#   1. `env_file:` on each service — the literal contents become that
#      container's process environment (this is what the app, Caddy, and
#      the backup scripts read).
#   2. `--env-file .env.production` on the docker compose CLI — lets the
#      compose YAML itself use ${POSTGRES_PASSWORD} etc.
# Because of (1), values here are NOT expanded — DATABASE_URL's password
# must be typed out the same as POSTGRES_PASSWORD below, not referenced.
# scripts/generate-prod-secrets.sh keeps these in sync for you; if you
# edit by hand, keep the pairs noted below identical.
#
# NEVER commit this file. It's gitignored (`.env.*` minus `.env.example`
# in .dockerignore, `.env` and `.env.*.local` in .gitignore — add this
# exact filename to .gitignore too if you rename it).

# --- core
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# The API's OWN public base URL — the api.* host, NOT the browser origin.
# src/telegram/telegram-polling.service.ts builds the webhook URL from it,
# so it must be the hostname Telegram can reach: https://<API_DOMAIN>.
APP_URL=https://api.alishaxkids.uz
# Browser CORS allow-list: the origin(s) the client UI is served from.
# With the UI on its own domain this is NOT the same as APP_URL — it is
# https://<UI_DOMAIN>. Comma-separated; add a staging origin if one exists.
# Never widen it to a reflected/wildcard origin: paired with
# `credentials: true` that lets any website read authenticated responses.
CORS_ORIGINS=https://alishaxkids.uz

# --- Caddy (deploy/Caddyfile reads these three directly)
# BOTH hostnames need an A record pointing at this server before Caddy
# starts, or the ACME challenge fails for whichever one doesn't resolve.
UI_DOMAIN=alishaxkids.uz
API_DOMAIN=api.alishaxkids.uz
ACME_EMAIL=REPLACE_ME@alishaxkids.uz

# --- client UI image (compose `web` service — profile-gated)
# Published to GHCR by the FRONTEND repo's CI, not by this one. Leave this
# commented out until that image exists; the `web` profile is off by
# default so the API stack runs fine without it. Once it exists:
#   uncomment, then add `--profile web` to the compose commands.
# WEB_IMAGE=ghcr.io/rasulovjamshid/alishax-web:latest

# --- database
# Password here MUST equal POSTGRES_PASSWORD below — same credential,
# two places, because of the env_file-not-expanded note above.
POSTGRES_DB=kindergarten
POSTGRES_USER=kg_app
POSTGRES_PASSWORD=REPLACE_ME_GENERATE_A_STRONG_PASSWORD
DATABASE_URL=postgresql://kg_app:REPLACE_ME_GENERATE_A_STRONG_PASSWORD@postgres:5432/kindergarten
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- auth
# 32+ random bytes. `openssl rand -base64 48` or let the generator script
# do it. Rotating this instantly invalidates every session (see
# kindergarten-docs/docs/06-ops-reference.md §6, "suspected unauthorized
# access" incident procedure).
JWT_SECRET=REPLACE_ME_32_PLUS_RANDOM_BYTES
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- storage (pluggable: local | s3)
# ops-reference §6: start with `local` for a single app container: one
# less credential set, and backup is a plain tar. Only switch to `s3`
# once you're running 2+ api containers.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/data/files
# s3/minio — only read when STORAGE_DRIVER=s3, and the `minio` compose
# service itself is profile-gated: start it with
# `docker compose ... --profile s3 up -d` (not plain `up -d`) or it never
# runs. Access/secret key MUST equal MINIO_ROOT_USER / MINIO_ROOT_PASSWORD,
# which docker-compose.prod.yml sets FROM these same two variables — so
# there's only one place to edit.
#
# Known gotcha on some budget KVM hosts: the official minio/minio image
# requires the x86-64-v2 CPU feature set and crash-loops with "Fatal glibc
# error: CPU does not support x86-64-v2" if the hypervisor doesn't expose
# it. Check `lscpu | grep Flags` for sse4_2/popcnt before relying on this.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=kg-files
S3_ACCESS_KEY=REPLACE_ME_MINIO_USER
S3_SECRET_KEY=REPLACE_ME_GENERATE_A_STRONG_PASSWORD
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=20
ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# --- telegram (leave disabled until you actually have a bot token)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RATE_LIMIT_PER_SEC=25

# --- localization / time
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=ru
DEFAULT_CURRENCY=UZS

# --- jobs
PGBOSS_SCHEMA=jobs
JOB_CONCURRENCY=5
REPORT_ASYNC_ROW_THRESHOLD=5000

# --- observability
LOG_LEVEL=info
# Leave blank to run without Sentry (errors still go to stdout/pino logs,
# just no aggregation/alerting). Recommended before real go-live.
SENTRY_DSN=

# --- seed (first boot only — creates tenant + Owner login)
SEED_TENANT_CODE=REPLACE_ME
SEED_TENANT_NAME="REPLACE_ME Kindergarten"
SEED_OWNER_EMAIL=REPLACE_ME@example.uz
# Change this immediately after first login even though the generator
# script randomizes it — it's shown once, in this file, on the server.
SEED_OWNER_PASSWORD=REPLACE_ME_GENERATE_A_STRONG_PASSWORD

# --- backups (scripts/backup.sh, scripts/restore.sh, deploy/backup/*)
BACKUP_DIR=/backup
# Exactly one required — scripts/backup.sh refuses to run unencrypted.
# Recipient (asymmetric, `gpg --import` a public key into the backup
# container/volume first) is preferred for production: the passphrase
# variant means anyone who can read this file can also decrypt every
# backup it produces.
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PASSPHRASE=
