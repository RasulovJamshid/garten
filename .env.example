# --- core
NODE_ENV=development
PORT=3010
API_PREFIX=/api/v1
APP_URL=http://localhost:3010
# Comma-separated browser CORS allow-list. Defaults to APP_URL alone if
# unset — never leave this as a wildcard/reflected origin in production.
CORS_ORIGINS=

# --- database
DATABASE_URL=postgresql://kg_app:kg_app_dev_password@localhost:5433/kindergarten
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- auth
JWT_SECRET=change-me-to-32-plus-random-bytes-before-any-real-use
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- storage (pluggable: local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/files
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kg-files
S3_ACCESS_KEY=kg_minio
S3_SECRET_KEY=kg_minio_dev_password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=20
ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# --- telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RATE_LIMIT_PER_SEC=25

# --- localization / time
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=ru
DEFAULT_CURRENCY=UZS

# --- jobs
PGBOSS_SCHEMA=jobs
JOB_CONCURRENCY=5
# Reports/receipts over this many rows go through the async export_job
# path (202 + job id) instead of streaming synchronously.
REPORT_ASYNC_ROW_THRESHOLD=5000

# --- observability
LOG_LEVEL=info
SENTRY_DSN=

# --- seed (dev only — first tenant + owner user)
SEED_TENANT_CODE=demo
SEED_TENANT_NAME=Demo Kindergarten
SEED_OWNER_EMAIL=owner@demo.local
SEED_OWNER_PASSWORD=ChangeMe12345!

# --- backups (scripts/backup.sh, scripts/restore.sh — not read by the app itself)
BACKUP_DIR=/backup
# Exactly one of these two is required by scripts/backup.sh — an
# unencrypted dump of financial/PII data is not an acceptable default.
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PASSPHRASE=
