# Public build configuration, read by scripts/deploy-frontend.sh as Bash.
# Keep values shell-quoted if they contain spaces. No credentials belong here.
FRONTEND_REPO=https://github.com/AzizBokhidjonov/alishax.git
FRONTEND_BRANCH=main
# Defaults to https://<API_DOMAIN><API_PREFIX> from .env.production.
# Use an absolute URL: this frontend also executes on the SSR server.
# FRONTEND_API_BASE_URL=https://api.alishaxkids.uz/api/v1
# FRONTEND_API_PROXY_TARGET=https://api.alishaxkids.uz
FRONTEND_LANDING_TENANT_CODE=
